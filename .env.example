# ---------- 素材源 API Key（可选，免费申请） ----------
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ---------- 服务 ----------
PORT=5178

# ---------- 下载保护（防触发风控） ----------
# 同时下载数量（并发上限）
MAX_CONCURRENT=4
# 同一域名两次请求的最小间隔（毫秒）
MIN_REQUEST_INTERVAL_MS=500
# 每日下载上限（达到后自动停止，次日重置）
DAILY_DOWNLOAD_LIMIT=500
# 失败自动重试次数（指数退避，遇到 429/403 还会自动降速）
MAX_RETRIES=3

# ---------- 代理（可选） ----------
# 只让指定域名走代理，其余直连（避免拖慢国内源）
# 例如：PROXY_URL=http://127.0.0.1:7892
PROXY_URL=
# 逗号分隔的域名后缀；填 * 表示全部走代理
# 默认 archive.org —— 它是唯一被墙的源
PROXY_HOSTS=archive.org
