# ---------- 素材源 API Key（可选，免费申请） ----------
# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ---------- 服务 ----------
PORT=5178

# ---------- 下载保护（防触发风控） ----------
# 同时下载数量（并发上限）
MAX_CONCURRENT=4
# 同一域名两次请求的最小间隔（毫秒）
MIN_REQUEST_INTERVAL_MS=500
# 每日下载上限（达到后自动停止，次日重置）
DAILY_DOWNLOAD_LIMIT=500
# 失败自动重试次数（指数退避，遇到 429/403 还会自动降速）
MAX_RETRIES=3

# ---------- 代理（可选） ----------
# 只让指定域名走代理，其余直连（避免拖慢国内源）
# 例如：PROXY_URL=http://127.0.0.1:7892
PROXY_URL=
# 逗号分隔的域名后缀；填 * 表示全部走代理
# 例如：archive.org,youtube.com,googlevideo.com,ytimg.com
PROXY_HOSTS=archive.org

# ---------- YouTube / yt-dlp（可选） ----------
# 需先安装 yt-dlp；仅收录 Creative Commons 授权视频
# 搜索超时（毫秒）
YTDLP_SEARCH_TIMEOUT_MS=45000
# 空闲超时：多久没有输出就判定卡死并终止（防被平台限流后挂住）
YTDLP_IDLE_TIMEOUT_MS=60000
# 单个任务最长下载时长
YTDLP_MAX_DURATION_MS=900000
# 单条视频最长时长（秒），超过则不出现在结果里
YOUTUBE_MAX_DURATION=1800
